#include <stdio.h>
#include <math.h>
#include <stdbool.h>

int divisores(int c){
    int soma = 0, i;
    for (i = 1; i < c; i++) {
        if(c % i == 0){
            soma += i;
            }
    }
    return soma;
}


bool amigos(int a, int b){
    int resultado1, resultado2;
    
    resultado1 = divisores(a);
    resultado2 = divisores(b);
    
    if(resultado1 == b && resultado2 == a){
        return true;
    } else {
        return false;
    }
    
}

int main()
{
    int a,b;
    scanf("%d%d",&a,&b);
    if (amigos(a,b))
       printf("Os numeros %i e %i sao amigos\n", a,b);
    else
       printf("Os numeros %i e %i nao sao amigos\n", a,b);
    
    return 0;
}
