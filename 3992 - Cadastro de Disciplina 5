void historico(int index_mat, materias* listaMaterias, int index_mat2, materias2* listaMaterias2){
    int i, num_cred = 0;
    char ok[4] ="";
    double nota = 0;
    
    printf("%4s %-50s %4s %4s/%1s %5s\n", "Cod.", "Nome", "Cred", "Ano", "S", "Media");
    for ( i = 0; i < index_mat; i++) {
        if(listaMaterias[i].codigo >= 0){
            printf("%04d %-50s %4d %4d/%d %05.2lf\n", listaMaterias[i].codigo, listaMaterias[i].nome, listaMaterias[i].cred, listaMaterias[i].ano, listaMaterias[i].semestre, listaMaterias[i].media);
            num_cred += listaMaterias[i].cred;
            nota += listaMaterias[i].media * listaMaterias[i].cred;
        }
    }
    for ( i = 0; i < index_mat2; i++) {
        if(listaMaterias2[i].codigo >= 0){
            printf("%04d %-50s %4d %4d/%d %05.2lf\n", listaMaterias2[i].codigo, listaMaterias2[i].nome, listaMaterias2[i].cred, listaMaterias2[i].ano, listaMaterias2[i].semestre, listaMaterias2[i].media);
            num_cred += listaMaterias2[i].cred;
            nota += listaMaterias2[i].media * listaMaterias2[i].cred;
        }
    }
    if(num_cred > 0){
        nota = nota/num_cred;
    } else {
        nota = 0.0;
    }
    printf("%-67s %05.2lf\n", "Coeficiente de Rendimento", nota);
    while (strcmp(ok, "Ok") != 0){
        scanf("%s", ok);
    }
}

int menu(){
    int resposta = 0;
    
    while (resposta < 1 || resposta > 10){
        printf("1 - inserir nova disciplina tipo 1\n2 - inserir nova disciplina tipo 2\n3 - inserir nova disciplina tipo 3\n4 - remover disciplina pelo codigo\n5 - alterar disciplina pelo codigo\n"
        "6 - listar todas as disciplinas\n7 - listar disciplinas de um ano/semestre\n8 - listar disciplinas pelo nome/professor\n"
        "9 - Historico\n10 - sair\nEntre com a sua opcao:\n");
        scanf("%d", &resposta);
    }
    return resposta;
    
}

