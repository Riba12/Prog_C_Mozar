double media(double a, double b, int tipo){
    switch(tipo){
        case 1:
            return (a + 2*b) / 3;
        case 2: 
            return (a + b) / 2;
    }
}
double media3(double a, double b, double c){
    return (2*a + 3*b + 5*c) / 10;
}

int achar_codigo(int codigo,int index_mat, materias* listaMaterias) {
    int i;
    
    for (i = 0; i < index_mat; i++) {
                if(listaMaterias[i].codigo == codigo ){
                    return i;
                }
            }
    return -1;
}

