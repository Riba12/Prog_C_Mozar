#include <stdio.h>
#include <math.h>
#include <stdbool.h>
#include <string.h>


typedef struct{
    int codigo;
    char nome[201];
    char prof[201];
    int cred;
    int ano;
    int semestre;
    double nt1;
    double nt2;
    double media;
}materias;

void input(materias *materia){
   scanf("%d%*c",&(*materia).codigo);
   scanf("%[^\n]%*c",(*materia).nome);
   scanf("%[^\n]%*c",(*materia).prof);
   scanf("%i",&(*materia).cred);
   scanf("%i",&(*materia).ano);
   scanf("%i",&(*materia).semestre);
   scanf("%lf",&(*materia).nt1);
   scanf("%lf",&(*materia).nt2);
}

double media(double a, double b){
    return (a + 2*b) / 3;
}

int menu(){
    int resposta = 0;
    
    while (resposta < 1 || resposta > 4){
        printf("1 - inicializar\n2 - inserir nova disciplina\n3 - listar historico\n4 - sair\nEntre com a sua opcao:\n");
        scanf("%d", &resposta);
    }
    return resposta;
    
}

int main()
{
    materias listaMaterias[25];
    int index_mat = 0;
    int i;
    materias materia;
    char ok[4];
    bool rodando = true;
    while(rodando){
     switch(menu()){
        case 1:
            index_mat = 0;
            printf("Historico inicializado com sucesso!\n");
            break;
        case 2:
            input(&materia);
            materia.media = media(materia.nt1, materia.nt2);
            printf("Disciplina inserida com sucesso!\n");
            listaMaterias[index_mat] = materia;
            index_mat++;
            break;
        case 3:
            printf("%4s %-50s %4s %4s/%1s %5s\n", "Cod.", "Nome", "Cred", "Ano", "S", "Media");
            for ( i = 0; i < index_mat; i++) {
                printf("%04d %-50s %4d %4d/%d %05.2lf\n", listaMaterias[i].codigo, listaMaterias[i].nome, listaMaterias[i].cred, listaMaterias[i].ano, listaMaterias[i].semestre, listaMaterias[i].media);
            }
            while (strcmp(ok, "Ok") != 0){
                scanf("%s", ok);
            }
            break;
        case 4:
            printf("Obrigado por utilizar o programa de cadastro, volte sempre!\n");
            rodando = false;
            break;
           
    }
    }
    
    return 0;
}
